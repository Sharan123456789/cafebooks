# CafeBooks server settings.  Copy to .env for local use (.env is never committed).
# On Vercel, set these in Project Settings -> Environment Variables instead.

# Shared database for the web app.  Adding a Neon / Postgres database to a Vercel project sets
# DATABASE_URL automatically.  Leave unset locally to use a SQLite file in CAFEBOOKS_DATA_DIR.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional
# CAFEBOOKS_DATA_DIR=./data             # SQLite file, local backups and logs (desktop / single server)
# CAFEBOOKS_BACKUP_STORE=database       # "files" (folder) or "database"; Vercel always uses "database"
# CAFEBOOKS_BACKUP_DIR=./data/backups
# CRON_SECRET=change-me-to-a-long-random-string   # Vercel sends it to the daily backup job
